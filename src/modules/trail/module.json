{
  "id": "trail",
  "name": "Trail Delay",
  "abbrev": "TRL",
  "version": "0.2.0",
  "description": "Lush stereo delay: tempo-syncable, modulated, filtered feedback with reverb tail",
  "author": "Local",
  "ui": "ui.js",
  "ui_chain": "ui_chain.js",
  "dsp": "dsp.so",
  "api_version": 2,
  "capabilities": {
    "audio_out": true,
    "audio_in": true,
    "midi_in": false,
    "note_driven": false,
    "midi_out": false,
    "chainable": true,
    "requires_continuous_processing": true,
    "component_type": "audio_fx",
    "ui_hierarchy": {
      "levels": {
        "root": {
          "name": "Trail Delay",
          "list_param": "preset",
          "count_param": "preset_count",
          "name_param": "preset_name",
          "params": [
            { "default": 0.12, "key": "time", "max": 1, "min": 0, "name": "Time", "step": 0.01, "type": "float", "unit": "%" },
            { "default": 0, "key": "sync", "max": 9, "min": 0, "name": "Sync", "step": 1, "type": "int" },
            { "default": 0.22, "key": "feedback", "max": 0.88, "min": 0, "name": "Feedback", "step": 0.01, "type": "float", "unit": "%" },
            { "default": 0.55, "key": "tone", "max": 1, "min": 0, "name": "Tone", "step": 0.01, "type": "float", "unit": "%" },
            { "default": 0.2, "key": "mod", "max": 1, "min": 0, "name": "Mod", "step": 0.01, "type": "float", "unit": "%" },
            { "default": 0.5, "key": "width", "max": 1, "min": 0, "name": "Width", "step": 0.01, "type": "float", "unit": "%" },
            { "default": 0.15, "key": "drive", "max": 1, "min": 0, "name": "Drive", "step": 0.01, "type": "float", "unit": "%" },
            { "default": 0.05, "key": "space", "max": 1, "min": 0, "name": "Space", "step": 0.01, "type": "float", "unit": "%" },
            { "default": 0.18, "key": "mix", "max": 1, "min": 0, "name": "Mix", "step": 0.01, "type": "float", "unit": "%" }
          ],
          "knobs": ["time", "sync", "feedback", "tone", "mod", "width", "drive", "space", "mix"]
        }
      }
    }
  }
}
