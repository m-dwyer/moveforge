{
  "id": "trail",
  "name": "Trail Delay",
  "abbrev": "TRL",
  "version": "0.2.0",
  "description": "Lush stereo delay: tempo-syncable, modulated, filtered feedback with reverb tail",
  "author": "Local",
  "kind": "effect",
  "io": { "audio_in": true, "audio_out": true, "midi_in": false, "midi_out": false },
  "requires_continuous_processing": true,
  "preset_browse": { "group": "root", "list_param": "preset", "count_param": "preset_count", "name_param": "preset_name" },
  "groups": [
    {
      "key": "root",
      "name": "Trail Delay",
      "params": [
        { "key": "time", "name": "Time", "type": "float", "min": 0, "max": 1, "default": 0.12, "step": 0.01, "unit": "%" },
        { "key": "sync", "name": "Sync", "type": "int", "min": 0, "max": 9, "default": 0, "step": 1 },
        { "key": "feedback", "name": "Feedback", "type": "float", "min": 0, "max": 0.88, "default": 0.22, "step": 0.01, "unit": "%" },
        { "key": "tone", "name": "Tone", "type": "float", "min": 0, "max": 1, "default": 0.55, "step": 0.01, "unit": "%" },
        { "key": "mod", "name": "Mod", "type": "float", "min": 0, "max": 1, "default": 0.2, "step": 0.01, "unit": "%" },
        { "key": "width", "name": "Width", "type": "float", "min": 0, "max": 1, "default": 0.5, "step": 0.01, "unit": "%" },
        { "key": "drive", "name": "Drive", "type": "float", "min": 0, "max": 1, "default": 0.15, "step": 0.01, "unit": "%" },
        { "key": "space", "name": "Space", "type": "float", "min": 0, "max": 1, "default": 0.05, "step": 0.01, "unit": "%" },
        { "key": "mix", "name": "Mix", "type": "float", "min": 0, "max": 1, "default": 0.18, "step": 0.01, "unit": "%" }
      ],
      "knobs": ["time", "sync", "feedback", "tone", "mod", "width", "drive", "space", "mix"]
    }
  ]
}
