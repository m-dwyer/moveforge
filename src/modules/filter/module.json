{
  "id": "filter",
  "name": "Multimode Filter",
  "abbrev": "FLT",
  "version": "0.1.0",
  "description": "Stereo state-variable filter morphing lowpass to bandpass to highpass",
  "author": "Local",
  "ui": "ui.js",
  "ui_chain": "ui_chain.js",
  "dsp": "dsp.so",
  "api_version": 2,
  "capabilities": {
    "audio_out": true,
    "audio_in": true,
    "midi_in": true,
    "note_driven": true,
    "midi_out": false,
    "chainable": true,
    "component_type": "audio_fx",
    "scope": { "mode": "continuous", "style": "envelope", "window": 1024 },
    "ui_hierarchy": {
      "levels": {
        "root": {
          "name": "Multimode Filter",
          "list_param": "preset",
          "count_param": "preset_count",
          "name_param": "preset_name",
          "params": [
            {
              "default": 18000,
              "key": "cutoff",
              "max": 18000,
              "min": 20,
              "name": "Cutoff",
              "step": 0.1,
              "type": "float",
              "unit": "Hz",
              "taper": "exp"
            },
            {
              "default": 0.5,
              "key": "resonance",
              "max": 20,
              "min": 0.5,
              "name": "Resonance",
              "step": 0.001,
              "type": "float",
              "unit": "Q",
              "taper": "exp"
            },
            { "default": 0, "key": "morph", "max": 1, "min": 0, "name": "Morph", "step": 0.01, "type": "float", "unit": "%" },
            { "default": 0, "key": "env_amount", "max": 8, "min": -8, "name": "Env Amount", "step": 0.01, "type": "float", "unit": "oct" },
            { "default": 0, "key": "filter_attack", "max": 2, "min": 0, "name": "Filter Attack", "step": 0.001, "type": "float", "unit": "sec" },
            { "default": 0.2, "key": "filter_decay", "max": 4, "min": 0, "name": "Filter Decay", "step": 0.01, "type": "float", "unit": "sec" },
            { "default": 0, "key": "filter_sustain", "max": 1, "min": 0, "name": "Filter Sustain", "step": 0.01, "type": "float", "unit": "%" },
            { "default": 0.2, "key": "filter_release", "max": 6, "min": 0, "name": "Filter Release", "step": 0.01, "type": "float", "unit": "sec" }
          ],
          "knobs": ["cutoff", "resonance", "morph", "env_amount", "filter_attack", "filter_decay", "filter_sustain", "filter_release"]
        }
      }
    }
  }
}
