{
  "id": "ballast",
  "name": "Ballast",
  "abbrev": "BAL",
  "version": "0.1.0",
  "description": "Kick, tom and sub-bass from one low-end voice: two-stage pitch envelope, click and grain layers, tilt into five drive curves",
  "author": "Local",
  "ui": "ui.js",
  "ui_chain": "ui_chain.js",
  "dsp": "dsp.so",
  "api_version": 2,
  "capabilities": {
    "audio_out": true,
    "audio_in": false,
    "midi_in": true,
    "note_driven": true,
    "midi_out": false,
    "chainable": true,
    "component_type": "sound_generator",
    "scope": { "mode": "continuous", "style": "envelope", "window": 1024 },
    "ui_hierarchy": {
      "levels": {
        "root": {
          "name": "Ballast",
          "list_param": "preset",
          "count_param": "preset_count",
          "name_param": "preset_name",
          "params": [
            { "default": 33, "key": "tune", "max": 72, "min": 24, "name": "Tune", "step": 0.01, "type": "float" },
            { "default": 0.5, "key": "punch", "max": 1, "min": 0, "name": "Punch", "step": 0.01, "type": "float", "unit": "%" },
            { "default": 0.45, "key": "drop", "max": 1, "min": 0, "name": "Drop", "step": 0.01, "type": "float", "unit": "%" },
            { "default": 0.45, "key": "decay", "max": 3, "min": 0.05, "name": "Decay", "step": 0.01, "type": "float", "unit": "sec" },
            { "default": 0.3, "key": "drive", "max": 1, "min": 0, "name": "Drive", "step": 0.01, "type": "float", "unit": "%" },
            { "default": 0.5, "key": "tone", "max": 1, "min": 0, "name": "Tone", "step": 0.01, "type": "float", "unit": "%" },
            { "default": 0, "key": "dirt", "max": 1, "min": 0, "name": "Dirt", "step": 0.01, "type": "float", "unit": "%" },
            { "default": 0.75, "key": "volume", "max": 1, "min": 0, "name": "Volume", "step": 0.01, "type": "float", "unit": "%" },
            { "default": 0, "key": "track", "max": 1, "min": 0, "name": "Track", "step": 0.01, "type": "float", "unit": "%" },
            { "default": 0.22, "key": "sweep", "max": 1, "min": 0, "name": "Sweep", "step": 0.01, "type": "float", "unit": "%" },
            { "default": 0.35, "key": "shape", "max": 1, "min": 0, "name": "Shape", "step": 0.01, "type": "float", "unit": "%" },
            { "default": 0, "key": "phase", "max": 1, "min": 0, "name": "Phase", "step": 0.01, "type": "float", "unit": "%" },
            { "default": 0, "key": "curve", "max": 4, "min": 0, "name": "Curve", "step": 1, "type": "int" },
            { "default": 0.2, "key": "body", "max": 1, "min": 0, "name": "Body", "step": 0.01, "type": "float", "unit": "%" },
            { "default": 0.6, "key": "vel_depth", "max": 1, "min": 0, "name": "Vel Depth", "step": 0.01, "type": "float", "unit": "%" },
            { "default": 0, "key": "human", "max": 1, "min": 0, "name": "Human", "step": 0.01, "type": "float", "unit": "%" }
          ],
          "knobs": [
            "tune",
            "punch",
            "drop",
            "decay",
            "drive",
            "tone",
            "dirt",
            "volume",
            "track",
            "sweep",
            "shape",
            "phase",
            "curve",
            "body",
            "vel_depth",
            "human"
          ]
        }
      }
    }
  }
}
