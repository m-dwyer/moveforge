{
  "id": "faust_drive",
  "name": "Faust Drive",
  "abbrev": "FDR",
  "version": "0.1.0",
  "description": "Faust-authored stereo drive/tone/mix",
  "author": "Local",
  "ui": "ui.js",
  "ui_chain": "ui_chain.js",
  "dsp": "dsp.so",
  "api_version": 2,
  "capabilities": {
    "audio_out": true,
    "audio_in": true,
    "midi_in": false,
    "midi_out": false,
    "chainable": true,
    "component_type": "audio_fx",
    "ui_hierarchy": {
      "levels": {
        "root": {
          "name": "Faust Drive",
          "params": [
            { "default": 0.3, "key": "drive", "max": 1, "min": 0, "name": "Drive", "step": 0.01, "type": "float", "unit": "%" },
            { "default": 0.5, "key": "tone", "max": 1, "min": 0, "name": "Tone", "step": 0.01, "type": "float", "unit": "%" },
            { "default": 1, "key": "mix", "max": 1, "min": 0, "name": "Mix", "step": 0.01, "type": "float", "unit": "%" },
            { "default": 0.8, "key": "level", "max": 1, "min": 0, "name": "Level", "step": 0.01, "type": "float", "unit": "%" }
          ],
          "knobs": ["drive", "tone", "mix", "level"]
        }
      }
    }
  }
}
