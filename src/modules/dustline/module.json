{
  "id": "dustline",
  "name": "Dustline",
  "abbrev": "DLN",
  "version": "0.1.0",
  "description": "Compact subtractive voice with oscillator blend, noise, resonant filter, and drive",
  "author": "Local",
  "ui": "ui.js",
  "ui_chain": "ui_chain.js",
  "dsp": "dsp.so",
  "api_version": 2,
  "capabilities": {
    "audio_out": true,
    "audio_in": false,
    "midi_in": true,
    "note_driven": true,
    "midi_out": false,
    "chainable": true,
    "component_type": "sound_generator",
    "ui_hierarchy": {
      "levels": {
        "root": {
          "name": "Dustline",
          "params": [
            { "default": 0.72, "key": "volume", "max": 1, "min": 0, "name": "Volume", "step": 0.01, "type": "float", "unit": "%" },
            { "default": 0.35, "key": "wave", "max": 1, "min": 0, "name": "Wave", "step": 0.01, "type": "float", "unit": "%" },
            { "default": 0.18, "key": "noise", "max": 1, "min": 0, "name": "Noise", "step": 0.01, "type": "float", "unit": "%" },
            { "default": 0.42, "key": "cutoff", "max": 1, "min": 0, "name": "Cutoff", "step": 0.01, "type": "float", "unit": "%" },
            { "default": 0.18, "key": "resonance", "max": 0.95, "min": 0, "name": "Reso", "step": 0.01, "type": "float", "unit": "%" },
            { "default": 0.008, "key": "attack", "max": 2, "min": 0.001, "name": "Attack", "step": 0.001, "type": "float", "unit": "sec" },
            { "default": 0.55, "key": "release", "max": 6, "min": 0.02, "name": "Release", "step": 0.01, "type": "float", "unit": "sec" },
            { "default": 0.22, "key": "drive", "max": 1, "min": 0, "name": "Drive", "step": 0.01, "type": "float", "unit": "%" },
            { "default": 2, "key": "bend_range", "max": 12, "min": 0, "name": "Bend", "step": 0.1, "type": "float", "unit": "st" }
          ],
          "knobs": ["volume", "wave", "noise", "cutoff"]
        }
      }
    }
  }
}
