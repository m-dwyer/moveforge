{
  "id": "lobber",
  "name": "Lobber",
  "abbrev": "LOB",
  "version": "0.1.0",
  "description": "Tempo-locked slice buffer: toss/stutter/reverse/freeze incoming audio",
  "author": "Local",
  "kind": "effect",
  "io": { "audio_in": true, "audio_out": true, "midi_in": true, "midi_out": false },
  "requires_continuous_processing": true,
  "scope": { "mode": "continuous", "style": "envelope", "window": 1024 },
  "preset_browse": { "group": "root", "list_param": "preset", "count_param": "preset_count", "name_param": "preset_name" },
  "groups": [
    {
      "key": "root",
      "name": "Lobber",
      "params": [
        { "key": "active", "name": "Lob", "type": "int", "min": 0, "max": 1, "default": 0, "step": 1 },
        { "key": "offset", "name": "Slices Back", "type": "int", "min": 0, "max": 16, "default": 2, "step": 1 },
        { "key": "division", "name": "Slice", "type": "int", "min": 0, "max": 5, "default": 2, "step": 1 },
        { "key": "mode", "name": "Play Mode", "type": "int", "min": 0, "max": 2, "default": 0, "step": 1 },
        { "key": "loop", "name": "Loop", "type": "int", "min": 0, "max": 1, "default": 1, "step": 1 },
        { "key": "ratchet", "name": "Ratchet", "type": "int", "min": 0, "max": 4, "default": 0, "step": 1 },
        { "key": "reverse", "name": "Reverse", "type": "int", "min": 0, "max": 1, "default": 0, "step": 1 },
        { "key": "freeze", "name": "Freeze", "type": "int", "min": 0, "max": 1, "default": 0, "step": 1 },
        { "key": "mute", "name": "Mute", "type": "int", "min": 0, "max": 1, "default": 0, "step": 1 },
        { "key": "capture", "name": "Capture", "type": "int", "min": 0, "max": 1, "default": 0, "step": 1 },
        { "key": "loop_beats", "name": "Loop Beats", "type": "int", "min": 1, "max": 16, "default": 4, "step": 1 },
        { "key": "mix", "name": "Mix", "type": "float", "min": 0, "max": 1, "default": 1, "step": 0.01, "unit": "%" },
        { "key": "bpm", "name": "Tempo", "type": "int", "min": 40, "max": 200, "default": 120, "step": 1 },
        { "key": "xfade", "name": "Declick", "type": "float", "min": 0, "max": 25, "default": 4, "step": 0.5, "unit": "ms" }
      ],
      "knobs": ["active", "offset", "division", "mode", "loop", "reverse", "freeze", "mix", "ratchet", "mute", "loop_beats", "capture", "bpm", "xfade"]
    }
  ]
}
