{
  "id": "lobber",
  "name": "Lobber",
  "abbrev": "LOB",
  "version": "0.1.0",
  "description": "Tempo-locked slice buffer: toss/stutter/reverse/freeze incoming audio",
  "author": "Local",
  "ui": "ui.js",
  "ui_chain": "ui_chain.js",
  "dsp": "dsp.so",
  "api_version": 2,
  "capabilities": {
    "audio_out": true,
    "audio_in": true,
    "midi_in": true,
    "note_driven": false,
    "midi_out": false,
    "chainable": true,
    "requires_continuous_processing": true,
    "component_type": "audio_fx",
    "scope": { "mode": "continuous", "style": "envelope", "window": 1024 },
    "ui_hierarchy": {
      "levels": {
        "root": {
          "name": "Lobber",
          "list_param": "preset",
          "count_param": "preset_count",
          "name_param": "preset_name",
          "params": [
            { "default": 0, "key": "active", "max": 1, "min": 0, "name": "Lob", "step": 1, "type": "int" },
            { "default": 2, "key": "offset", "max": 16, "min": 0, "name": "Slices Back", "step": 1, "type": "int" },
            { "default": 2, "key": "division", "max": 5, "min": 0, "name": "Slice", "step": 1, "type": "int" },
            { "default": 0, "key": "mode", "max": 2, "min": 0, "name": "Play Mode", "step": 1, "type": "int" },
            { "default": 1, "key": "loop", "max": 1, "min": 0, "name": "Loop", "step": 1, "type": "int" },
            { "default": 0, "key": "ratchet", "max": 4, "min": 0, "name": "Ratchet", "step": 1, "type": "int" },
            { "default": 0, "key": "reverse", "max": 1, "min": 0, "name": "Reverse", "step": 1, "type": "int" },
            { "default": 0, "key": "freeze", "max": 1, "min": 0, "name": "Freeze", "step": 1, "type": "int" },
            { "default": 0, "key": "mute", "max": 1, "min": 0, "name": "Mute", "step": 1, "type": "int" },
            { "default": 0, "key": "capture", "max": 1, "min": 0, "name": "Capture", "step": 1, "type": "int" },
            { "default": 4, "key": "loop_beats", "max": 16, "min": 1, "name": "Loop Beats", "step": 1, "type": "int" },
            { "default": 1, "key": "mix", "max": 1, "min": 0, "name": "Mix", "step": 0.01, "type": "float", "unit": "%" },
            { "default": 120, "key": "bpm", "max": 200, "min": 40, "name": "Tempo", "step": 1, "type": "int" },
            { "default": 4, "key": "xfade", "max": 25, "min": 0, "name": "Declick", "step": 0.5, "type": "float", "unit": "ms" }
          ],
          "knobs": ["active", "offset", "division", "mode", "loop", "reverse", "freeze", "mix", "ratchet", "mute", "loop_beats", "capture", "bpm", "xfade"]
        }
      }
    }
  }
}
