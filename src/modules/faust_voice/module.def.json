{
  "id": "faust_voice",
  "name": "Faust Voice",
  "abbrev": "FVC",
  "version": "0.1.0",
  "description": "Faust-authored monophonic sawtooth voice with ADSR and resonant LPF",
  "author": "Local",
  "kind": "instrument",
  "io": { "audio_in": false, "audio_out": true, "midi_in": true, "note_driven": true, "midi_out": false },
  "scope": { "mode": "continuous", "style": "triggered", "window": 1024 },
  "groups": [
    {
      "key": "root",
      "name": "Faust Voice",
      "params": [
        { "key": "cutoff", "name": "Cutoff", "type": "float", "min": 0, "max": 1, "default": 0.6, "step": 0.01, "unit": "%" },
        { "key": "resonance", "name": "Resonance", "type": "float", "min": 0, "max": 1, "default": 0.3, "step": 0.01, "unit": "%" },
        { "key": "attack", "name": "Attack", "type": "float", "min": 0.001, "max": 1, "default": 0.01, "step": 0.001, "unit": "sec" },
        { "key": "release", "name": "Release", "type": "float", "min": 0.01, "max": 4, "default": 0.3, "step": 0.01, "unit": "sec" },
        { "key": "level", "name": "Level", "type": "float", "min": 0, "max": 1, "default": 0.7, "step": 0.01, "unit": "%" }
      ],
      "knobs": ["cutoff", "resonance", "attack", "release"]
    }
  ]
}
