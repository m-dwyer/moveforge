{
  "id": "faust_voice",
  "name": "Faust Voice",
  "abbrev": "FVC",
  "version": "0.1.0",
  "description": "Faust-authored monophonic sawtooth voice with ADSR and resonant LPF",
  "author": "Local",
  "ui": "ui.js",
  "ui_chain": "ui_chain.js",
  "dsp": "dsp.so",
  "api_version": 2,
  "capabilities": {
    "audio_out": true,
    "audio_in": false,
    "midi_in": true,
    "midi_out": false,
    "chainable": true,
    "component_type": "sound_generator",
    "scope": { "mode": "continuous", "style": "triggered", "window": 1024 },
    "ui_hierarchy": {
      "levels": {
        "root": {
          "name": "Faust Voice",
          "params": [
            { "default": 0.6, "key": "cutoff", "max": 1, "min": 0, "name": "Cutoff", "step": 0.01, "type": "float", "unit": "%" },
            { "default": 0.3, "key": "resonance", "max": 1, "min": 0, "name": "Resonance", "step": 0.01, "type": "float", "unit": "%" },
            { "default": 0.01, "key": "attack", "max": 1, "min": 0.001, "name": "Attack", "step": 0.001, "type": "float", "unit": "sec" },
            { "default": 0.3, "key": "release", "max": 4, "min": 0.01, "name": "Release", "step": 0.01, "type": "float", "unit": "sec" },
            { "default": 0.7, "key": "level", "max": 1, "min": 0, "name": "Level", "step": 0.01, "type": "float", "unit": "%" }
          ],
          "knobs": ["cutoff", "resonance", "attack", "release"]
        }
      }
    }
  }
}
