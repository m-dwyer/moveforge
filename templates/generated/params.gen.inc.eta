/* GENERATED by scripts/gen-params.ts from module.json — do not edit. */
/* Regenerate with: mise run gen-params (or: pnpm run gen-params) */

#ifndef <%= it.guard %>
#define <%= it.guard %>

/* <%= it.upper %>_PARAM_COUNT and the <%= it.upper %>_PARAM_* enum. Also included by
 * <%= it.moduleId %>_core.h; the guard makes the second include a no-op. */
#include "<%= it.moduleId %>_params.gen.h"
<% /*
  A Faust adapter captures one zone pointer per param into <coreType>.zones,
  indexed by param id, so the array has to track the param count exactly. Ask the
  compiler instead of searching the header text: this catches an undersized array,
  an oversized one, a renamed member (no zones member to take the sizeof) and a
  stale count, none of which text matching sees reliably — and the failure lands
  at build time with the reason attached, rather than as an out-of-bounds write
  with no redzone for ASan to catch (plan 3.3/7.3).
*/ -%>
<% if (it.isFaust) { -%>

/* zones[] is indexed by param id, so it must track <%= it.upper %>_PARAM_COUNT. */
_Static_assert(sizeof(((<%= it.coreType %> *)0)->zones) / sizeof(void *)
                   == <%= it.upper %>_PARAM_COUNT,
               "<%= it.coreType %>.zones[] must be sized <%= it.upper %>_PARAM_COUNT");
<% } -%>

static inline float <%= it.moduleId %>_params_clampf_(float x, float lo, float hi) {
    return x < lo ? lo : (x > hi ? hi : x);
}

int <%= it.moduleId %>_param_id(const char *key) {
    if (!key) return -1;
<% it.params.forEach((p) => { -%>
    if (strcmp(key, "<%= p.key %>") == 0) return <%= it.enumName(p.key) %>;
<% }) -%>
    return -1;
}

void <%= it.moduleId %>_set_param(<%= it.coreType %> *s, int param_id, float value) {
    if (!s) return;
    switch (param_id) {
<% it.params.forEach((p) => { -%>
        case <%= it.enumName(p.key) %>: s-><%= p.key %> = <%= it.moduleId %>_params_clampf_(value, <%= it.cf(p.min) %>, <%= it.cf(p.max) %>); break;
<% }) -%>
        default: break;
    }
}

float <%= it.moduleId %>_get_param(const <%= it.coreType %> *s, int param_id) {
    if (!s) return 0.0f;
    switch (param_id) {
<% it.params.forEach((p) => { -%>
        case <%= it.enumName(p.key) %>: return s-><%= p.key %>;
<% }) -%>
        default: return 0.0f;
    }
}

void <%= it.moduleId %>_apply_defaults(<%= it.coreType %> *s) {
    if (!s) return;
<% it.params.forEach((p) => { -%>
    s-><%= p.key %> = <%= it.cf(p.default) %>;
<% }) -%>
}

#endif
