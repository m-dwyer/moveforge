{
  "id": "{{moduleId}}",
  "name": "{{moduleName}}",
  "abbrev": "{{moduleAbbrev}}",
  "version": "0.1.0",
  "description": "{{moduleName}} Faust audio effect",
  "author": "Local",
  "kind": "effect",
  "io": { "audio_in": true, "audio_out": true, "midi_in": false, "note_driven": false, "midi_out": false },
  "scope": { "mode": "continuous", "style": "envelope", "window": 1024 },
  "preset_browse": { "group": "root", "list_param": "preset", "count_param": "preset_count", "name_param": "preset_name" },
  "groups": [
    {
      "key": "root",
      "name": "{{moduleName}}",
      "params": [
        { "key": "mix", "name": "Mix", "type": "float", "min": 0, "max": 1, "default": 1, "step": 0.01 },
        { "key": "level", "name": "Level", "type": "float", "min": 0, "max": 1, "default": 1, "step": 0.01 }
      ],
      "knobs": ["mix", "level"]
    }
  ]
}
